# Copy to .env (ignored by git) and fill in what you need.

# Locally served models (vLLM, OpenAI-compatible)
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=EMPTY

# Azure OpenAI: each model is a separate resource with its own endpoint and key.
# Leave blank to call the public OpenAI API with OPENAI_API_KEY (synthetic data only).
GPT4O_ENDPOINT=
GPT4O_DEPLOYMENT=
GPT4O_API_KEY=
GPT5_ENDPOINT=
GPT5_DEPLOYMENT=
GPT5_API_KEY=
AZURE_API_VERSION=2024-12-01-preview
OPENAI_API_KEY=

# Snowstorm SNOMED CT server
SNOMED_SERVER_URL=http://localhost:8081

# Inputs and outputs (defaults use the synthetic example)
NOTES_DIR=data/synthetic/episodes
RESULTS_DIR=results/runs
EXAMPLE_NOTE_PATH=data/synthetic/example_note.json
EXAMPLE_ANNOTATION_PATH=data/synthetic/example_annotation.json
CLASSIFICATION_LOOKUP=data/snomed_to_icd_opcs.json
